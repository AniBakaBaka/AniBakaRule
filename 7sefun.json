{
  "format": "anx-rule/2",
  "id": "7sefun",
  "name": "七色番",
  "baseUrl": "https://www.7sefun.top",
  "iconUrl": "https://www.7sefun.top/pc/img/favicon.ico",
  "description": "七色番提供最新番剧TV、剧场版在线高速播放，每日及时更新，是动漫迷的不二选择！",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://www.7sefun.top/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "fetch",
      "url": "https://www.7sefun.top/vodsearch/-------------.html?wd={keyword}"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "jsonSeries",
            "listPath": "list",
            "idKey": "id",
            "nameKey": "name",
            "imageKey": "pic",
            "urlKey": "url"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              "a.video-wrapper[href*=\"/voddetail/\"], .module-card-item, .module-poster-item, .module-search-item, .stui-vodlist__box, .stui-vodlist li, a[href*=\"/voddetail/\"], a[href*=\"/vod/detail/\"], a[href*=\"/detail/\"]"
            ]
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".vod-play-list-container, .module-play-list, .module-player-list, .stui-content__playlist, .anthology-list-box, .anthology-list-play, .playlist, .play-list, .play_list, .episode-list, #playlist, .episodes"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "setVar",
            "name": "playerTarget",
            "value": "{url:raw}"
          },
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.7sefun.top/"
            }
          },
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "setVar",
            "name": "lmmToken",
            "value": "{url:raw}"
          },
          {
            "op": "template",
            "value": "https://yun.92cj.com/acfun58.php?id={lmmToken:raw}&referer={playerTarget}"
          },
          {
            "op": "sniff",
            "goal": "video",
            "followEmbeddedPlayer": true,
            "timeoutMs": 30000
          }
        ],
        [
          {
            "op": "setVar",
            "name": "playerTarget",
            "value": "{url:raw}"
          },
          {
            "op": "template",
            "value": "https://dp.no3acg.com/player/ec.php?code=qw&if=1&from=lmm&url={playerTarget}"
          },
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.7sefun.top/"
            }
          },
          {
            "op": "ecPlayer"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video",
            "url": "{episodeId:raw}"
          }
        ]
      ]
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Referer": "https://www.7sefun.top/"
      }
    }
  ]
}
