{
  "format": "anx-rule/2",
  "id": "hanimeone",
  "name": "Hanime1.me (Mirror)",
  "baseUrl": "https://hanimeone.me",
  "iconUrl": "https://vdownload.hembed.com/image/icon/tab_logo.png?secure=EJYLwnrDlidVi_wFp3DaGw==,4867726124",
  "description": "Hanime1.me 带给你完美的H动漫、H动画、里番在线看体验。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://hanimeone.me/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "fetch",
      "url": "https://hanimeone.me/search?query={keyword}"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "jsonSeries",
            "listPath": "list",
            "idKey": "id",
            "nameKey": "name",
            "imageKey": "pic",
            "urlKey": "url"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              "a.video-link[href*=\"/watch?v=\"]"
            ]
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "template",
      "value": "{\"episodes\":[{\"id\":\"{seriesId:raw}\",\"name\":\"正片\"}]}"
    },
    {
      "op": "jsonEpisodes",
      "episodesPath": "episodes",
      "episodeIdTemplate": "{id:raw}",
      "sourceName": "Hanime1"
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "select",
            "css": "video#player source[size=\"720\"], video#player source, video source",
            "attr": "src"
          }
        ],
        [
          {
            "op": "regex",
            "pattern": "<source\\s+src=[\"\\']([^\"\\']+\\.mp4[^\"\\']*)",
            "group": 1
          }
        ],
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video"
          }
        ]
      ]
    }
  ]
}
