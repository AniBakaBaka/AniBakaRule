{
  "format": "anx-rule/2",
  "id": "ani_pekolove",
  "name": "佩可爱动漫 (peko.love)",
  "baseUrl": "https://ani.pekolove.net",
  "iconUrl": "https://ani.pekolove.net/wp-content/uploads/cropped-acglogo2-2-32x32.png",
  "description": "佩可爱动漫 (peko.love)，为您提供优质的动漫在线播放与分享。",
  "directConnection": true,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36",
    "Referer": "https://ani.pekolove.net/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "https://ani.pekolove.net/?s={keyword}"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "searchList",
            "selectors": [
              "a[itemprop=\"name\"]"
            ]
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              "a[itemprop=\"name\"][href*=\"/anime/\"]",
              "a[class^=\"ptl-\"][href*=\"/anime/\"]",
              "a[class*=\" ptl-\"][href*=\"/anime/\"]"
            ],
            "detailPattern": "/anime/"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "roadsXPath": "//div[contains(@class, \"entry-content\")]",
      "itemsXPath": ".//div[contains(@class, \"wp-block-columns\") and contains(@class, \"is-not-stacked-on-mobile\")]//a[contains(@class, \"pbb-\") and contains(text(), \"集\")]"
    }
  ],
  "play": [
    {
      "op": "fetch",
      "url": "{episodeId:raw}/?_={timestamp:raw}",
      "headers": {
        "Cache-Control": "no-cache",
        "Referer": "https://ani.pekolove.net/"
      }
    },
    {
      "op": "select",
      "css": "iframe[data-src*=\"/anime/player/?url=\"]",
      "attr": "data-src"
    },
    {
      "op": "setVar",
      "name": "playerUrl",
      "value": "{url:raw}"
    },
    {
      "op": "fetch",
      "url": "{playerUrl:raw}",
      "headers": {
        "Referer": "{episodeId:raw}"
      }
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "query",
            "name": "url",
            "input": "{playerUrl:raw}"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    },
    {
      "op": "setMediaHeaders",
      "materializeHls": true,
      "headers": {
        "Accept": "*/*",
        "Origin": "https://video.pekolove.mov",
        "Referer": "{playerUrl:raw}",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36"
      }
    }
  ]
}
