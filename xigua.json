{
  "format": "anx-rule/2",
  "id": "xigua",
  "name": "西瓜卡通",
  "baseUrl": "https://www.xgcartoon.com",
  "iconUrl": "https://www.xgcartoon.com/xgct/icon/favicon-32x32.png",
  "description": "西瓜卡通视频源，源网址www.xgcartoon.com",
  "useWebview": true,
  "headers": {
    "Referer": "https://www.xgcartoon.com/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/search?q={keyword}"
    },
    {
      "op": "searchList",
      "listXPath": "//a[contains(@class,\"topic-list-item\")]",
      "nameXPath": ".//div[contains(@class,\"h3\")]",
      "linkXPath": ""
    }
  ],
  "detail": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "{seriesId:raw}"
          },
          {
            "op": "episodes",
            "listSelectors": [
              ".detail-right__volumes"
            ]
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "{seriesId:raw}",
            "readyContains": [
              "detail-right__volumes"
            ],
            "rejectContains": [
              "Page not found",
              "页面不存在"
            ],
            "timeoutMs": 30000,
            "settleMs": 1500
          },
          {
            "op": "episodes",
            "listSelectors": [
              ".detail-right__volumes"
            ]
          }
        ]
      ]
    }
  ],
  "play": [
    {
      "op": "regex",
      "pattern": "^(?:https?://[^/?#]+)?(?:/user/page_direct\\?[^#]*?chapter_id=|/video/[^/?#]+/)([A-Za-z0-9_-]+)(?:\\.html)?(?:[&#][^#]*)?$",
      "group": 1
    },
    {
      "op": "template",
      "value": "https://www.xgcartoon.com/user/amp/content_pframe_url?chapter_id={url:raw}&level=middle&expires=3600"
    },
    {
      "op": "regex",
      "pattern": "^(https://www\\.xgcartoon\\.com/user/amp/content_pframe_url\\?chapter_id=[A-Za-z0-9_-]+&level=middle&expires=3600)$",
      "group": 1
    },
    {
      "op": "follow"
    },
    {
      "op": "json",
      "path": "data"
    },
    {
      "op": "regex",
      "pattern": "^https://pframe\\.xgcartoon\\.com/pframe/player\\.htm\\?vid=([a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+)(?:&[^\\s]*)?$",
      "group": 1,
      "ignoreCase": true
    },
    {
      "op": "template",
      "value": "https://xgct-video.bzcdn.net/{url:raw}/video_info.json"
    },
    {
      "op": "regex",
      "pattern": "^(https://xgct-video\\.bzcdn\\.net/[a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+/video_info\\.json)$",
      "group": 1,
      "ignoreCase": true
    },
    {
      "op": "follow"
    },
    {
      "op": "json",
      "path": "guid"
    },
    {
      "op": "regex",
      "pattern": "^([a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+)$",
      "group": 1,
      "ignoreCase": true
    },
    {
      "op": "template",
      "value": "https://xgct-video.bzcdn.net/{url:raw}/playlist.m3u8"
    },
    {
      "op": "regex",
      "pattern": "^(https://xgct-video\\.bzcdn\\.net/[a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+-[a-f0-9]+/playlist\\.m3u8)$",
      "group": 1,
      "ignoreCase": true
    }
  ]
}
