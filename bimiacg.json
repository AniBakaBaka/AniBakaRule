{
  "format": "anx-rule/2",
  "id": "bimiacg",
  "name": "Bimiacg",
  "baseUrl": "https://www.bimiacg14.net",
  "iconUrl": "https://www.bimiacg14.net/favicon.ico",
  "description": "Bimiacg WebView challenge-aware 视频源",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://www.bimiacg14.net/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "maccmsSuggest",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "Referer": "https://www.bimiacg14.net/"
            },
            "detailUrlTemplate": "/bangumi/bi/{id}/"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "/vod/search/wd/{keyword}/",
            "readyRegex": "(?:/bangumi/bi/|没有找到|暂无相关|搜索结果为空)",
            "readyIgnoreCase": true,
            "rejectContains": [
              "X-GE-UA-Step",
              "ge_ua_p",
              "DokiDoki CDN",
              "安全检查中"
            ],
            "timeoutMs": 35000,
            "settleMs": 1000
          },
          {
            "op": "searchList",
            "selectors": [
              "a[href*=\"/bangumi/bi/\"]"
            ],
            "detailPattern": "/bangumi/bi/"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "sniff",
      "goal": "html",
      "url": "{seriesId:raw}",
      "readyRegex": "(?:player_list|play_source_tab|/play/)",
      "readyIgnoreCase": true,
      "rejectContains": [
        "X-GE-UA-Step",
        "ge_ua_p",
        "DokiDoki CDN",
        "安全检查中"
      ],
      "timeoutMs": 35000,
      "settleMs": 1000
    },
    {
      "op": "episodes",
      "tabSelectors": [
        ".play_source_tab a",
        ".play_source_tab span",
        "#tab a",
        "#tab span"
      ],
      "listSelectors": [
        ".player_list",
        ".play_box",
        ".play_list",
        ".playlist"
      ]
    }
  ],
  "play": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "sniff",
            "goal": "video",
            "url": "{episodeId:raw}"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "{episodeId:raw}",
            "readyRegex": "(?:player_aaaa|/static/danmu/play\\.php|<video|<source)",
            "readyIgnoreCase": true,
            "rejectContains": [
              "X-GE-UA-Step",
              "ge_ua_p",
              "DokiDoki CDN",
              "安全检查中"
            ],
            "timeoutMs": 35000,
            "settleMs": 1000
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "{episodeId:raw}",
            "readyRegex": "(?:player_aaaa|/static/danmu/play\\.php|<video|<source)",
            "readyIgnoreCase": true,
            "rejectContains": [
              "X-GE-UA-Step",
              "ge_ua_p",
              "DokiDoki CDN",
              "安全检查中"
            ],
            "timeoutMs": 35000,
            "settleMs": 1000
          },
          {
            "op": "select",
            "css": "iframe[src*=\"/static/danmu/play.php\"]",
            "attr": "src"
          },
          {
            "op": "sniff",
            "goal": "video"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "{episodeId:raw}",
            "readyRegex": "(?:player_aaaa|/static/danmu/play\\.php|<video|<source)",
            "readyIgnoreCase": true,
            "rejectContains": [
              "X-GE-UA-Step",
              "ge_ua_p",
              "DokiDoki CDN",
              "安全检查中"
            ],
            "timeoutMs": 35000,
            "settleMs": 1000
          },
          {
            "op": "playerAaaa"
          },
          {
            "op": "template",
            "value": "/static/danmu/play.php?url={url}&myurl={episodeId}"
          },
          {
            "op": "sniff",
            "goal": "video"
          }
        ]
      ]
    }
  ]
}
