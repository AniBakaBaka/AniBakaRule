{
  "format": "anx-rule/2",
  "id": "anime1",
  "name": "Anime1",
  "baseUrl": "https://anime1.me",
  "iconUrl": "https://anime1.me/favicon-32x32.png",
  "description": "Anime1 番剧源，源网站 anime1.me，建议使用繁体中文搜索。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://anime1.me/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "https://anime1.me/animelist.json"
    },
    {
      "op": "jsonSeries",
      "idKey": "[0]",
      "nameKey": "[1]",
      "keywordMatch": true,
      "caseSensitive": true
    }
  ],
  "detail": [
    {
      "op": "fetch",
      "url": "https://anime1.me/?cat={seriesId:raw}"
    },
    {
      "op": "select",
      "css": "video[data-apireq]",
      "attr": "data-apireq",
      "all": true,
      "unique": true,
      "nextSelector": ".nav-previous a",
      "maxPages": 32
    },
    {
      "op": "jsonEpisodes",
      "episodesPath": "",
      "episodeIdTemplate": "{id:raw}",
      "reverse": true,
      "sourceName": "Anime1",
      "episodeNameTemplate": "第{index}集"
    }
  ],
  "play": [
    {
      "op": "urlDecode"
    },
    {
      "op": "setVar",
      "name": "token",
      "value": "{url:raw}"
    },
    {
      "op": "fetch",
      "url": "https://v.anime1.me/api",
      "method": "POST",
      "contentType": "form",
      "body": {
        "d": "{token:raw}"
      },
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Origin": "https://anime1.me",
        "Referer": "https://anime1.me/"
      },
      "cookieSession": true
    },
    {
      "op": "json",
      "path": "s[0].src"
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 13_3_1) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.4 Safari/605.1.15",
        "Accept": "*/*",
        "Referer": "https://anime1.me/"
      },
      "cookieNames": [
        "e",
        "p",
        "h"
      ],
      "cookiePrefixes": [
        "_ga"
      ],
      "validateWithCookies": true
    }
  ]
}
