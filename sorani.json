{
  "format": "anx-rule/2",
  "id": "sorani",
  "name": "青空次元 (Sorani)",
  "baseUrl": "https://api.sorani.cc",
  "iconUrl": "https://www.sorani.net/favicon.ico",
  "description": "青空次元 (Sorani)，提供高质量 1080P 动画在线播放。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Accept": "application/json, text/plain, */*",
    "Origin": "https://www.sorani.net",
    "Referer": "https://www.sorani.net/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/sorani-cms/api/video?page=1&size=20&keyword={keyword}&enabled=true&sortMode=latest&sortDesc=true"
    },
    {
      "op": "jsonSeries",
      "listPath": "data.records",
      "idKey": "id",
      "nameKey": "title",
      "imageKey": "cover",
      "descKey": "summary",
      "detailUrlTemplate": "/sorani-cms/api/video/{id}"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "jsonEpisodes",
      "episodesPath": "data.episodes",
      "episodeNameKey": "episodeLabel",
      "episodeIdTemplate": "{episodeId:raw}",
      "sourceName": "青空次元"
    }
  ],
  "play": [
    {
      "op": "fetch",
      "url": "/sorani-cms/api/video/episode/{episodeId:raw}/play?lineCode=anime_jp_m3u8"
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
        "Accept": "*/*",
        "Origin": "https://www.sorani.net",
        "Referer": "https://www.sorani.net/"
      }
    },
    {
      "op": "json",
      "path": "data.playUrl"
    }
  ]
}
