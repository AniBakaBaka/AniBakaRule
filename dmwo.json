{
  "format": "anx-rule/2",
  "id": "dmwo",
  "name": "动漫窝",
  "baseUrl": "https://www.dmwo.one",
  "iconUrl": "https://www.dmwo.one/template/shoutu7/img/favicon.ico",
  "description": "动漫窝提供最新动画、热门动漫和动画电影在线观看。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://www.dmwo.one/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "maccmsSuggest",
      "detailUrlTemplate": "/voddetail/{id}.html",
      "verify": true
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        "ul.stui-content__playlist"
      ],
      "tabSelectors": [
        ".stui-pannel__head h3.title"
      ]
    }
  ],
  "play": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "follow"
          },
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "regex",
            "pattern": "^(https?://\\S+\\.(?:m3u8|mp4)(?:[?#]\\S*)?)$",
            "group": 1
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video",
            "url": "{episodeId:raw}"
          }
        ]
      ]
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
        "Referer": "https://www.dmwo.one/"
      }
    }
  ]
}
