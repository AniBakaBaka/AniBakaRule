{
  "format": "anx-rule/2",
  "id": "jibi",
  "name": "叽哔动漫网",
  "baseUrl": "https://www.jibi.cc",
  "iconUrl": "https://www.jibi.cc/upload/mxprocms/20240530-1/811f55cb787194c59e3f6d1d8724571c.jpg",
  "description": "叽哔动漫网拥有上万集高清晰画质的在线动漫，观看完全免费、无须注册、高速播放。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Referer": "https://www.jibi.cc/"
  },
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "maccmsSuggest",
            "detailUrlTemplate": "/index.php/vod/detail/id/{id}.html"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              ".module-card-item, .module-items .module-item"
            ]
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".stui-content__playlist, .myui-content__playlist, .myui-content__list, .module-play-list, .module-play-list-content, .module-player-list, .anthology-list-box, .play_list_box, .playlist-list, .playlist_full, .playlist, .play-list, .play_list, .fed-play-item, .hl-plays-list, #playlist, .episode-list"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    }
  ]
}
