{
  "format": "anx-rule/2",
  "id": "4kcz",
  "name": "厂长资源",
  "baseUrl": "https://www.4kcz.com",
  "iconUrl": "https://gimg1.baidu.com/gimg/app=2001&n=0&g=0n&fmt=png&src=img.czzy66.com/2020/05/cropped-90b07fe57d6142-192x192.png",
  "description": "厂长资源提供电影、剧集、番剧和动漫剧场版等高清影视资源在线观看。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://www.4kcz.com/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "/boss1O1?q={keyword}"
          },
          {
            "op": "searchList",
            "selectors": [
              ".search_list li"
            ],
            "detailPattern": "/movie/"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "/boss1O1?q={keyword}",
            "readyContains": [
              "search_list",
              "/movie/"
            ],
            "rejectContains": [
              "403 Forbidden"
            ],
            "timeoutMs": 45000,
            "settleMs": 1200
          },
          {
            "op": "searchList",
            "selectors": [
              ".search_list li"
            ],
            "detailPattern": "/movie/"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".paly_list_btn"
      ]
    }
  ],
  "play": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "{episodeId:raw}"
          },
          {
            "op": "select",
            "css": "iframe.viframe",
            "attr": "src"
          },
          {
            "op": "fetch"
          },
          {
            "op": "regex",
            "pattern": "const\\s+mysvg\\s*=\\s*'([^']+)'",
            "group": 1
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video",
            "followEmbeddedPlayer": true,
            "timeoutMs": 30000
          }
        ]
      ]
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
        "Referer": "https://www.4kcz.com/"
      }
    }
  ]
}
