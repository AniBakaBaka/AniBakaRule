{
  "format": "anx-rule/2",
  "id": "dmhy",
  "name": "动漫花园",
  "baseUrl": "https://share.dmhy.org",
  "iconUrl": "https://share.dmhy.org/favicon.ico",
  "description": "按番剧展示搜索结果，字幕组作为播放线路，按实际集数对齐。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml",
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "useWebview": true,
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "/topics/list?keyword={keyword}"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "/topics/list?keyword={keyword}"
          }
        ]
      ]
    },
    {
      "op": "torrentRecords",
      "mode": "series",
      "rowSelector": "#topic_list tbody tr",
      "titleSelector": "td.title a[target=\"_blank\"]",
      "titleAttr": "text",
      "idSelector": "a[href^=\"magnet:\"]",
      "idAttr": "href",
      "sourceNameSelector": "td.title span.tag a",
      "sourceNameAttr": "text",
      "sizeSelector": "td:nth-child(5)",
      "sizeAttr": "text",
      "fansubPattern": {
        "pattern": "^[\\[【]([^\\]】]+)[\\]】]",
        "group": 1
      },
      "episodePatterns": [
        {
          "pattern": "S\\d+E(\\d+(?:\\.\\d+)?)",
          "group": 1
        },
        {
          "pattern": "[\\[【](\\d{1,3}(?:\\.\\d+)?)(?:v\\d+)?(?:\\s*(?:END|FIN))?[\\]】](?!\\s*[x×]\\s*\\d)",
          "group": 1
        },
        {
          "pattern": "第\\s*(\\d+(?:\\.\\d+)?)[話话集]",
          "group": 1
        },
        {
          "pattern": "EP\\.?\\s*(\\d+(?:\\.\\d+)?)",
          "group": 1
        },
        {
          "pattern": "[-–—]\\s*(\\d+(?:\\.\\d+)?)\\s*(?:v\\d+)?\\s*(?:END|FIN|FINAL)?",
          "group": 1
        }
      ],
      "titleStripPatterns": [
        "[\\[【][^\\]】]*[\\]】]",
        "[\\(（][^\\)）]*[\\)）]"
      ],
      "animeCleanupPatterns": [
        "[-–—：:]\\s*$",
        "^\\s*[-–—：:]"
      ],
      "animeNameSeparators": [
        "/",
        "_"
      ],
      "seriesIdTemplate": "{baseUrl:raw}/topics/list?keyword={animeName}",
      "descriptionTemplate": "{count:raw}个资源 · {fansubs:raw}",
      "animeNamePatterns": [
        {
          "pattern": "^[\\[【][^\\]】]+[\\]】]\\s*(?:(?:[\\[【★☆]\\d{1,2}月新番[\\]】★☆])\\s*)*[\\[【]([^\\]】/_]+)[^\\]】]*[\\]】](?=\\s*(?:[\\[【]|$))",
          "group": 1
        }
      ],
      "excludePatterns": [
        "\\b(?:batch|complete)\\b",
        "合集|全集|一括",
        "(?:^|[\\[【(（\\s|]|第)\\d{1,3}\\s*(?:-|~|～|至)\\s*\\d{1,3}(?:[話话集\\]】)）\\s+]|$)"
      ],
      "requireEpisodeNumber": true
    }
  ],
  "detail": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "follow"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "{seriesId:raw}"
          }
        ]
      ]
    },
    {
      "op": "torrentRecords",
      "mode": "episodes",
      "rowSelector": "#topic_list tbody tr",
      "titleSelector": "td.title a[target=\"_blank\"]",
      "titleAttr": "text",
      "idSelector": "a[href^=\"magnet:\"]",
      "idAttr": "href",
      "sourceNameSelector": "td.title span.tag a",
      "sourceNameAttr": "text",
      "sizeSelector": "td:nth-child(5)",
      "sizeAttr": "text",
      "fansubPattern": {
        "pattern": "^[\\[【]([^\\]】]+)[\\]】]",
        "group": 1
      },
      "episodePatterns": [
        {
          "pattern": "S\\d+E(\\d+(?:\\.\\d+)?)",
          "group": 1
        },
        {
          "pattern": "[\\[【](\\d{1,3}(?:\\.\\d+)?)(?:v\\d+)?(?:\\s*(?:END|FIN))?[\\]】](?!\\s*[x×]\\s*\\d)",
          "group": 1
        },
        {
          "pattern": "第\\s*(\\d+(?:\\.\\d+)?)[話话集]",
          "group": 1
        },
        {
          "pattern": "EP\\.?\\s*(\\d+(?:\\.\\d+)?)",
          "group": 1
        },
        {
          "pattern": "[-–—]\\s*(\\d+(?:\\.\\d+)?)\\s*(?:v\\d+)?\\s*(?:END|FIN|FINAL)?",
          "group": 1
        }
      ],
      "titleStripPatterns": [
        "[\\[【][^\\]】]*[\\]】]",
        "[\\(（][^\\)）]*[\\)）]"
      ],
      "animeCleanupPatterns": [
        "[-–—：:]\\s*$",
        "^\\s*[-–—：:]"
      ],
      "animeNameSeparators": [
        "/",
        "_"
      ],
      "expectedAnimeNameQuery": "keyword",
      "unknownSourceName": "未知字幕组",
      "episodeIndexMode": "number",
      "episodeNameTemplate": "第{episode:raw}话{sizeSuffix:raw}",
      "animeNamePatterns": [
        {
          "pattern": "^[\\[【][^\\]】]+[\\]】]\\s*(?:(?:[\\[【★☆]\\d{1,2}月新番[\\]】★☆])\\s*)*[\\[【]([^\\]】/_]+)[^\\]】]*[\\]】](?=\\s*(?:[\\[【]|$))",
          "group": 1
        }
      ],
      "excludePatterns": [
        "\\b(?:batch|complete)\\b",
        "合集|全集|一括",
        "(?:^|[\\[【(（\\s|]|第)\\d{1,3}\\s*(?:-|~|～|至)\\s*\\d{1,3}(?:[話话集\\]】)）\\s+]|$)"
      ],
      "requireEpisodeNumber": true,
      "dedupeByEpisode": true,
      "scoreRules": [
        {
          "pattern": "1080",
          "score": 40
        },
        {
          "pattern": "2160|4k",
          "score": 35
        },
        {
          "pattern": "720",
          "score": 20
        },
        {
          "pattern": "chs|简",
          "score": 12
        },
        {
          "pattern": "\\bgb\\b",
          "score": 6
        },
        {
          "pattern": "cht|繁",
          "score": 4
        },
        {
          "pattern": "mp4",
          "score": 5
        },
        {
          "pattern": "mkv",
          "score": 3
        },
        {
          "pattern": "hevc|h\\.?265",
          "score": 2
        }
      ]
    }
  ],
  "play": [
    {
      "op": "template",
      "value": "{episodeId:raw}"
    }
  ]
}
