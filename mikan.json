{
  "format": "anx-rule/2",
  "id": "mikan",
  "name": "蜜柑计划",
  "baseUrl": "https://mikanani.me",
  "iconUrl": "https://mikanani.me/images/favicon.ico?v=2",
  "description": "按番剧展示搜索结果，字幕组作为播放线路，按实际集数对齐。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml",
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/Home/Search?searchstr={keyword}"
    },
    {
      "op": "torrentRecords",
      "mode": "series",
      "rowSelector": "ul.an-ul > li",
      "titleSelector": ".an-text",
      "titleAttrs": [
        "title",
        "text"
      ],
      "idSelector": "a[href*=\"/Home/Bangumi/\"]",
      "idAttr": "href",
      "imageSelector": "[data-src]",
      "imageAttr": "data-src"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "torrentRecords",
      "mode": "episodes",
      "sourceContainerSelector": ".episode-table",
      "sourceLabelSelector": ".subgroup-text > a:first-child",
      "sourceLabelAttr": "text",
      "rowSelector": "tbody tr",
      "titleSelector": ".magnet-link-wrap",
      "titleAttr": "text",
      "idSelectors": [
        "input[data-magnet]",
        "a[data-clipboard-text^=\"magnet:\"]",
        "a[href^=\"magnet:\"]",
        "a[href*=\".torrent\"]"
      ],
      "idAttrs": [
        "data-magnet",
        "data-clipboard-text",
        "href"
      ],
      "exactSourceSelector": "a[href*=\".torrent\"]",
      "exactSourceAttr": "href",
      "sizeSelector": "td:nth-child(3)",
      "sizeAttr": "text",
      "episodePatterns": [
        {
          "pattern": "S\\d+E(\\d+(?:\\.\\d+)?)",
          "group": 1
        },
        {
          "pattern": "\\[(\\d{1,3}(?:\\.\\d+)?)\\](?!\\s*[x×]\\s*\\d)",
          "group": 1
        },
        {
          "pattern": "[-–—]\\s*(\\d+(?:\\.\\d+)?)\\s*(?:v\\d+)?",
          "group": 1
        },
        {
          "pattern": "第\\s*(\\d+(?:\\.\\d+)?)[話话集]",
          "group": 1
        },
        {
          "pattern": "EP\\.?\\s*(\\d+(?:\\.\\d+)?)",
          "group": 1
        }
      ],
      "excludePatterns": [
        "\\b(?:batch|complete)\\b",
        "合集|全集|一括",
        "(?:^|[\\[【(（\\s|]|第)\\d{1,3}\\s*(?:-|~|～|至)\\s*\\d{1,3}(?:[話话集\\]】)）\\s+]|$)"
      ],
      "requireEpisodeNumber": true,
      "episodeIndexMode": "number",
      "dedupeByEpisode": true,
      "episodeNameTemplate": "第{episode:raw}话{sizeSuffix:raw}",
      "unknownSourceName": "未知字幕组",
      "sourceNameBonus": 1,
      "scoreRules": [
        {
          "pattern": "1080",
          "score": 40
        },
        {
          "pattern": "2160|4k",
          "score": 35
        },
        {
          "pattern": "720",
          "score": 20
        },
        {
          "pattern": "chs|简",
          "score": 12
        },
        {
          "pattern": "\\bgb\\b",
          "score": 6
        },
        {
          "pattern": "cht|繁",
          "score": 4
        },
        {
          "pattern": "mp4",
          "score": 5
        },
        {
          "pattern": "mkv",
          "score": 3
        },
        {
          "pattern": "hevc|h\\.?265",
          "score": 2
        }
      ]
    }
  ],
  "play": [
    {
      "op": "template",
      "value": "{episodeId:raw}"
    }
  ]
}
