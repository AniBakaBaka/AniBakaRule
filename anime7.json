{
  "format": "anx-rule/2",
  "id": "anime7",
  "name": "Anime7 动画线上看",
  "baseUrl": "https://anime7.top",
  "iconUrl": "https://ani7.b-cdn.net/upload/logo/web-icon.png",
  "description": "Anime7 动画线上看，提供日韩动漫、剧场版、国产动漫等高清在线观看。含广告。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
    "Referer": "https://anime7.top/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/index.php/ajax/suggest?mid=1&wd={keyword}&limit=20",
      "headers": {
        "X-Requested-With": "XMLHttpRequest"
      }
    },
    {
      "op": "jsonSeries",
      "listPath": "list",
      "idKey": "id",
      "nameKey": "name",
      "imageKey": "pic",
      "detailUrlTemplate": "/vod-detail/{id}/"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        "ul.hl-plays-list"
      ],
      "tabSelectors": [
        ".hl-plays-from a"
      ],
      "tabAttr": "alt"
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "filterHlsAds": true,
      "branches": [
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "regex",
            "pattern": "^(https?://\\S+\\.(?:m3u8|mp4|flv|mkv)(?:[?#]\\S*)?)$",
            "group": 1,
            "ignoreCase": true
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video",
            "url": "{episodeId:raw}"
          }
        ]
      ]
    },
    {
      "op": "setMediaHeaders",
      "remove": [
        "Referer"
      ]
    }
  ],
  "useWebview": true
}
