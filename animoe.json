{
  "format": "anx-rule/2",
  "id": "animoe",
  "name": "Animoe动漫",
  "baseUrl": "https://animoe.org",
  "iconUrl": "https://github.elemecdn.com/mstatic616/images/logo/favicon.png",
  "description": "Animoe动漫，提供最新番剧、经典动漫全集免费高清在线观看。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://animoe.org/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/index.php/ajax/suggest?mid=1&wd={keyword}&limit=20",
      "headers": {
        "X-Requested-With": "XMLHttpRequest"
      }
    },
    {
      "op": "jsonSeries",
      "listPath": "list",
      "idKey": "id",
      "nameKey": "name",
      "imageKey": "pic",
      "detailUrlTemplate": "/info/{id}.html"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".module-play-list"
      ],
      "tabSelectors": [
        ".module-tab-item[data-dropdown-value]"
      ],
      "tabAttr": "data-dropdown-value"
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "playerAaaa",
      "var": "player_aaaa",
      "key": "url",
      "hlsManifestDecode": {
        "scheme": "xor",
        "prefix": "enc",
        "key": [
          144,
          223,
          214,
          167,
          22,
          76,
          53
        ],
        "period": 10,
        "fallbackIndex": 6,
        "xor": 165,
        "skipBytes": 3,
        "trimPrefixBeforeM3u8": true
      }
    },
    {
      "op": "regex",
      "pattern": "^(https?://\\S+\\.(?:m3u8|mp4|flv|mkv)(?:[?#]\\S*)?)$",
      "group": 1,
      "ignoreCase": true
    }
  ]
}
