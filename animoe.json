{
  "format": "anx-rule/2",
  "id": "animoe",
  "name": "Animoe动漫",
  "baseUrl": "https://animoe.org",
  "iconUrl": "https://github.elemecdn.com/mstatic616/images/logo/favicon.png",
  "description": "Animoe动漫，提供最新番剧、经典动漫全集免费高清在线观看。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://animoe.org/"
  },
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "maccmsSuggest",
            "detailUrlTemplate": "/info/{id}.html"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              ".module-card-item, .module-items .module-item"
            ],
            "detailPattern": "/info/"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".module-play-list"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "playerAaaa",
      "var": "player_aaaa",
      "key": "url"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video"
          }
        ]
      ]
    }
  ]
}
