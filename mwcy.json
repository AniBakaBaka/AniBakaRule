{
  "format": "anx-rule/2",
  "id": "mwcy",
  "name": "喵物次元",
  "baseUrl": "https://www.mwcy.net",
  "iconUrl": "https://www.mwcy.net/favicon.ico",
  "description": "喵物次元，致力于动漫番剧资源收集，是一个二次元观影追番动漫网站。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://www.mwcy.net/"
  },
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "/search/wd/{keyword}.html"
          },
          {
            "op": "searchList",
            "selectors": [
              ".vod-detail.search-list"
            ],
            "detailPattern": "/bangumi/"
          }
        ],
        [
          {
            "op": "maccmsSuggest",
            "detailUrlTemplate": "/bangumi/{id}.html",
            "idTransform": "baseN",
            "idAlphabet": "CSqxIWYbLFQjsvy9RZdDu0HPait4MTU7NVenrwABXf2GK8EJOhklmp56cg13oz",
            "idSuffix": "CCS"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".anthology-list-box",
        ".anthology-list-play"
      ],
      "tabSelectors": [
        ".anthology-tab .swiper-slide",
        ".anthology-tab a",
        ".module-tab-item",
        ".tab-item"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "template",
            "value": "https://play.catw.moe/player/ec.php?code=qw&if=1&url={url}"
          },
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.mwcy.net/"
            }
          },
          {
            "op": "ecPlayer"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    }
  ]
}
