{
  "format": "anx-rule/2",
  "id": "11kt",
  "name": "去看吧 (QuKanBa)",
  "baseUrl": "https://11kt.net",
  "iconUrl": "https://k8dm.com/template/vfed/asset/img/favicon.png",
  "description": "海外更新最快的动漫社区，为您提供无修动漫、BL动漫等丰富动漫资源在线免费观看。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Referer": "https://11kt.net/"
  },
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "maccmsSuggest",
            "detailUrlTemplate": "/index.php/vod/detail/id/{id}.html"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              "dl.fed-deta-info"
            ]
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".fed-play-item"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "select",
            "css": "#fed-play-iframe",
            "attr": "data-play"
          },
          {
            "op": "regex",
            "pattern": "^...(.*)",
            "group": 1
          },
          {
            "op": "crypto",
            "algo": "base64",
            "mode": "decrypt"
          }
        ],
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    }
  ]
}
