{
  "format": "anx-rule/2",
  "id": "eacg1",
  "name": "EACG动漫",
  "baseUrl": "https://www.eacg1.com",
  "iconUrl": "https://k8dm.com/template/vfed/asset/img/favicon.png",
  "description": "EACG动漫，提供好看的现代耽美动漫和最新日番、表番在线免费播放。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Referer": "https://www.eacg1.com/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "https://www.eacg1.com/vodsearch/-------------.html?wd={keyword}"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "jsonSeries",
            "listPath": "list",
            "idKey": "id",
            "nameKey": "name",
            "imageKey": "pic",
            "detailUrlTemplate": "/voddetails-{id}.html"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              "dl.fed-deta-info"
            ],
            "detailPattern": "/voddetails-"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "tabSelectors": [
        ".fed-drop-tops li.fed-drop-btns a"
      ],
      "listSelectors": [
        ".fed-play-item"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "select",
            "css": "#fed-play-iframe",
            "attr": "data-play"
          },
          {
            "op": "replace",
            "pattern": "^.{3}",
            "regex": true,
            "replacement": ""
          },
          {
            "op": "crypto",
            "algo": "base64",
            "mode": "decrypt"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff"
          }
        ]
      ]
    }
  ]
}
