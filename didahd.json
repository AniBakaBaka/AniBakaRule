{
  "format": "anx-rule/2",
  "id": "didahd",
  "name": "嘀嗒影视 (Dida HD)",
  "baseUrl": "https://www.didahd.xyz",
  "iconUrl": "https://www.didahd.xyz/template/mytheme/statics/img/newfavicon.png",
  "description": "专注高分电影，高清HD在线，极速秒播不卡顿！",
  "useWebview": true,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Referer": "https://www.didahd.xyz/"
  },
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "maccmsSuggest",
            "detailUrlTemplate": "/detail/{id}.html",
            "verify": true
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              ".myui-vodlist__thumb, .searchkey"
            ]
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "maccmsVerify"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".myui-content__list"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "maccmsVerify"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "setVar",
            "name": "didaPlayerToken",
            "value": "{url:raw}"
          },
          {
            "op": "template",
            "value": "https://www.didahd.xyz/static/player/artplayer/?url={didaPlayerToken:raw}"
          },
          {
            "op": "sniff",
            "goal": "video",
            "followEmbeddedPlayer": true,
            "timeoutMs": 45000
          }
        ],
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video",
            "url": "{episodeId:raw}",
            "followEmbeddedPlayer": true,
            "timeoutMs": 45000
          }
        ]
      ]
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
      }
    }
  ]
}
