{
  "format": "anx-rule/2",
  "id": "huazidm",
  "name": "花子动漫",
  "baseUrl": "https://www.huazidm.com",
  "iconUrl": "https://www.huazidm.com/favicon.ico",
  "description": "花子动漫-新番在线观看，提供高清动漫在线播放。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://www.huazidm.com/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "sniff",
      "goal": "html",
      "url": "/search?keyword={keyword}",
      "readyContains": [
        "video-card"
      ],
      "timeoutMs": 15000,
      "settleMs": 2000
    },
    {
      "op": "searchList",
      "selectors": [
        "a.video-card[href*='/v/']"
      ],
      "detailPattern": "/v/"
    }
  ],
  "detail": [
    {
      "op": "sniff",
      "goal": "html",
      "url": "{seriesId:raw}",
      "readyContains": [
        "episode-pill"
      ],
      "timeoutMs": 15000,
      "settleMs": 2000
    },
    {
      "op": "episodes",
      "tabSelectors": [
        "button.source-tab"
      ],
      "listSelectors": [
        ".episode-grid.detail-episode-grid"
      ]
    }
  ],
  "play": [
    {
      "op": "sniff",
      "goal": "video",
      "url": "{episodeId:raw}"
    }
  ]
}
