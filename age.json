{
  "format": "anx-rule/2",
  "id": "age",
  "name": "AGE动漫",
  "baseUrl": "https://www.agedm.io",
  "iconUrl": "https://www.agedm.io/favicon.ico",
  "description": "AGE动漫视频源，源网址www.agedm.io",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Mobile Safari/537.36",
    "Referer": "https://m.agedm.io/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "fetch",
      "url": "/search?query={keyword}"
    },
    {
      "op": "searchList",
      "selectors": [
        ".cata_video_item",
        ".card"
      ],
      "detailPattern": "/detail/"
    }
  ],
  "detail": [
    {
      "op": "replace",
      "pattern": "http://www.agedm.io",
      "replacement": "https://www.agedm.io",
      "first": true
    },
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "tabSelectors": [
        "button[data-bs-target^=\"#playlist-source-\"]"
      ],
      "listSelectors": [
        "div[id^=\"playlist-source-\"]"
      ]
    }
  ],
  "play": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "replace",
            "input": "{episodeId:raw}",
            "pattern": "https://www.agedm.io/play/",
            "replacement": "https://m.agedm.io/#/play/",
            "first": true
          },
          {
            "op": "sniff",
            "goal": "video",
            "followEmbeddedPlayer": true,
            "timeoutMs": 45000
          }
        ],
        [
          {
            "op": "follow"
          },
          {
            "op": "select",
            "css": "iframe",
            "attr": "src"
          },
          {
            "op": "regex",
            "pattern": "[?&](?:url|v|vid)=(https?[^&]+)",
            "group": 1
          }
        ],
        [
          {
            "op": "follow"
          },
          {
            "op": "select",
            "css": "iframe",
            "attr": "src"
          },
          {
            "op": "sniff",
            "goal": "video"
          }
        ],
        [
          {
            "op": "follow"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "follow"
          },
          {
            "op": "select",
            "css": "iframe",
            "attr": "src"
          },
          {
            "op": "follow"
          },
          {
            "op": "videoUrl"
          },
          {
            "op": "regex",
            "pattern": "^(?!.*(?:adposter|/Play/ad|advertis|/ads?/|poster\\.mp4|loading\\.|ploading|preroll|midroll|postroll|commercial|promo\\.))https?://\\S+",
            "group": 0,
            "ignoreCase": true
          }
        ]
      ]
    }
  ]
}
